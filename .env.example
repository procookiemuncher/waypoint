# vida-360 - Life360 Observer credentials.
# Copy this file to `.env` and fill in ONE of the two options below.
# `.env` is gitignored - nothing here ever gets committed.

# OPTION 1 (recommended - works for passwordless / phone + SMS accounts):
# a bearer access token grabbed from an existing Life360 session.
# How to get it: docs/LIFE360_OBSERVER.md 3. Paste it here; leave USER/PASS blank.
LIFE360_TOKEN=

# OPTION 2 (only if your account actually has an email + password login):
LIFE360_USER=
LIFE360_PASS=
